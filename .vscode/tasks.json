{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure",
      "type": "shell",
      "command": "cmake --preset default",
      "problemMatcher": []
    },
    {
      "label": "cmake: build",
      "type": "shell",
      "command": "cmake --build build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "cmake: build (debug)",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build build/debug",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "./build/bin/simulation.exe",
      "dependsOn": "cmake: build",
      "problemMatcher": []
    }
  ]
}
